---
import { Picture } from 'astro:assets';
import poster from '../assets/photos/hero-snezka.jpg';
import data from '../data/routes.json';
import Icon from './Icon.astro';
import { currentTierIndex, kc, priceTiers, race } from '../data/race';

const r = data.routes.long;
const L = r.points[r.points.length - 1][0];
const MIN = 250;
const MAX = 1150;
const X = (km: number) => (km / L) * 1000;
const Y = (alt: number) => (1 - (alt - MIN) / (MAX - MIN)) * 100;
const area =
  r.points.map((p, i) => `${i ? 'L' : 'M'}${X(p[0]).toFixed(2)} ${Y(p[1]).toFixed(2)}`).join('') + 'L1000 100L0 100Z';

const peaks = ['Pomezní Boudy', 'Pražská bouda'].map((name) => {
  const w = r.waypoints.find((w) => w.name === name)!;
  const near = r.points.reduce((b, p) => (Math.abs(p[0] - w.km) < Math.abs(b[0] - w.km) ? p : b));
  return { ...w, x: (w.km / L) * 100, y: Y(near[1]) / 100 };
});

const ticks = [20, 40, 60, 80, 100, 120].map((k) => ({ k, x: (k / L) * 100 }));

const tier = currentTierIndex();
const t = priceTiers[tier];
const priceNow = t.short ? `Startovné teď od ${kc(t.short)} · ${t.label.toLowerCase()}` : `Startovné na místě ${kc(t.cash!)}`;
const tiersJson = JSON.stringify(priceTiers);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="media" data-hero-media data-yt={race.youtubeId}>
    <Picture
      src={poster}
      formats={['webp']}
      widths={[640, 960, 1440, 1920, 2500]}
      sizes="100vw"
      alt=""
      class="poster"
      loading="eager"
      fetchpriority="high"
    />
    <div class="scrim"></div>
  </div>

  <div class="content wrap">
    <h1 id="hero-title" class="t-display title">
      Krakonošův<br />cyklomaraton 2027
    </h1>
    <p class="tagline">{race.tagline}</p>
    <p class="facts t-label num">
      <span>Dlouhá 135 km</span><span>Krátká 86 km</span><span>Start a cíl Trutnov</span>
    </p>
    <div class="actions">
      <a class="btn" href={race.registrationUrl}>Registrovat se <Icon name="arrow" /></a>
      <p class="price num" data-price-now data-tiers={tiersJson}>{priceNow}</p>
    </div>
  </div>

  <div class="video-ctrl">
    <button class="vbtn" type="button" data-video-toggle aria-pressed="false">
      <Icon name="pause" class="i-pause" />
      <Icon name="play" class="i-play" />
      <span data-video-label>Pozastavit video</span>
    </button>
    <a class="vlink" href={`https://www.youtube.com/watch?v=${race.youtubeId}`} target="_blank" rel="noopener">
      Celé video se zvukem <Icon name="external" />
    </a>
  </div>

  <div class="ridge" aria-hidden="true">
    <svg viewBox="0 0 1000 100" preserveAspectRatio="none" class="ridge-svg">
      <path d={area} />
    </svg>
    {
      peaks.map((p) => (
        <span class="peak" style={`--x:${p.x}%;--y:${p.y};--t:${(0.4 + (p.x / 100) * 1.2).toFixed(2)}s`}>
          <span class="peak-name t-label">{p.name}</span>
        </span>
      ))
    }
    <div class="ridge-axis">
      <span class="ax-start">Start Trutnov</span>
      {
        ticks.map((t) => (
          <span class="num ax-tick" style={`left:${t.x}%`}>
            {t.k}
          </span>
        ))
      }
      <span class="num ax-end">Cíl {L.toLocaleString('cs-CZ', { maximumFractionDigits: 1 })} km</span>
    </div>
  </div>
</section>

<style>
  .hero {
    --ridge-h: clamp(7rem, 24vh, 13rem);
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: max(36rem, min(calc(100svh - var(--header-h)), 62rem));
    overflow: hidden;
    color: #fff;
    background: var(--ridge-900);
    isolation: isolate;
  }

  .media {
    position: absolute;
    inset: 0;
    z-index: -1;
    container-type: size;
  }

  .media :global(.poster),
  .media :global(picture) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .media :global(.poster) {
    object-fit: cover;
    object-position: 50% 35%;
  }

  .media :global(iframe) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100cqw, 177.78cqh);
    height: max(100cqh, 56.25cqw);
    transform: translate(-50%, -50%) scale(1.18);
    border: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  .media.is-playing :global(iframe) {
    opacity: 1;
  }

  /* reading scrim for the copy, lower left */
  .scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(6, 18, 33, 0.78) 0%, rgba(6, 18, 33, 0.35) 45%, rgba(6, 18, 33, 0) 70%),
      linear-gradient(to right, rgba(6, 18, 33, 0.55) 0%, rgba(6, 18, 33, 0) 60%);
  }

  .content {
    position: relative;
    padding-bottom: calc(var(--ridge-h) * 0.78 + 1rem);
  }

  .title {
    font-size: clamp(3.25rem, 9.2vw, 6rem);
    max-width: 12ch;
    text-shadow: 0 2px 24px rgba(6, 18, 33, 0.35);
  }

  .tagline {
    margin-top: 1.25rem;
    max-width: 34ch;
    font-size: clamp(1.1875rem, 2vw, 1.5rem);
    font-weight: 560;
    line-height: 1.3;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: 1rem;
    color: var(--ridge-200);
    font-size: 0.9375rem;
  }

  .facts span + span::before {
    content: '';
    display: inline-block;
    width: 0.35rem;
    height: 0.35rem;
    margin-right: 1.25rem;
    vertical-align: 0.15em;
    background: var(--red);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
  }

  .price {
    font-weight: 600;
    font-size: 1rem;
    color: #fff;
  }

  .video-ctrl {
    position: absolute;
    right: var(--gutter);
    top: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem 1.25rem;
    font-size: 0.9375rem;
  }

  .vbtn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.9rem 0 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 2px;
    background: rgba(6, 18, 33, 0.35);
    color: #fff;
    cursor: pointer;
    font-weight: 600;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .vbtn:hover {
    background: rgba(6, 18, 33, 0.6);
  }

  .vbtn :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .vbtn :global(.i-play),
  .vbtn[aria-pressed='true'] :global(.i-pause) {
    display: none;
  }

  .vbtn[aria-pressed='true'] :global(.i-play) {
    display: block;
  }

  .vlink {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    text-shadow: 0 1px 8px rgba(6, 18, 33, 0.6);
  }

  .vlink :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }

  /* the real long-route profile rising out of the video: it is the ground the page stands on */
  .ridge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--ridge-h);
    color: var(--ink);
  }

  .ridge-svg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 1.75rem;
    width: 100%;
    height: calc(100% - 1.75rem);
  }

  .ridge-svg path {
    fill: var(--snow);
  }

  .ridge::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.8rem;
    background: var(--snow);
  }

  .peak {
    position: absolute;
    left: var(--x);
    top: 0;
    height: calc((100% - 1.75rem) * var(--y));
    width: 0;
  }

  .peak::after {
    content: '';
    position: absolute;
    left: -4px;
    bottom: -4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--red);
  }

  .peak-name {
    position: absolute;
    left: 0;
    top: calc(100% + 0.7rem);
    transform: translateX(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    white-space: nowrap;
    color: var(--ink);
    font-size: 0.8125rem;
  }

  .peak-name .num {
    font-weight: 500;
    color: var(--ink-3);
  }

  .ridge-axis {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.35rem;
    height: 1.2rem;
    z-index: 1;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-3);
  }

  .ridge-axis span {
    position: absolute;
    white-space: nowrap;
  }

  .ax-tick {
    transform: translateX(-50%);
  }

  .ax-start {
    left: var(--gutter);
  }

  .ax-end {
    right: var(--gutter);
  }

  /* entrance: the ridge is ridden left to right once */
  :global(.js) .ridge-svg {
    animation: ride 1.8s var(--ease-out) 0.2s both;
  }

  :global(.js) .peak {
    animation: land 0.6s var(--ease-out) both;
    animation-delay: var(--t, 0.4s);
  }

  @keyframes ride {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes land {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 48rem) {
    .hero {
      --ridge-h: 6.5rem;
      min-height: max(34rem, calc(100svh - var(--header-h)));
    }

    .video-ctrl {
      top: 0.75rem;
    }

    .vlink {
      display: none;
    }

    .vbtn span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .vbtn {
      padding: 0;
      width: 2.75rem;
      justify-content: center;
    }

    .content {
      padding-bottom: calc(var(--ridge-h) * 0.6 + 3.5rem);
    }

    .peak-name {
      display: none;
    }

    .ax-tick {
      display: none;
    }
  }
</style>

<script>
  // current price tier, recomputed in the visitor's browser so a cached page stays right
  const priceEl = document.querySelector<HTMLElement>('[data-price-now]');
  if (priceEl) {
    const tiers: { until: string | null; label: string; short?: number; cash?: number }[] = JSON.parse(priceEl.dataset.tiers!);
    const day = new Date().toISOString().slice(0, 10);
    const t = tiers.find((x) => x.until && day <= x.until) ?? tiers[tiers.length - 1];
    const kc = (n: number) => `${n.toLocaleString('cs-CZ')} Kč`;
    priceEl.textContent = t.short ? `Startovné teď od ${kc(t.short)} · ${t.label.toLowerCase()}` : `Startovné na místě ${kc(t.cash!)}`;
  }

  // background video: YouTube (privacy-enhanced), loaded after the page, never under reduced motion or data saver
  const media = document.querySelector<HTMLElement>('[data-hero-media]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
  const label = document.querySelector<HTMLElement>('[data-video-label]');
  if (media && toggle && label) {
    const id = media.dataset.yt!;
    let frame: HTMLIFrameElement | null = null;
    let paused = false;

    const command = (func: string) =>
      frame?.contentWindow?.postMessage(JSON.stringify({ event: 'command', func, args: [] }), 'https://www.youtube-nocookie.com');

    const setPaused = (p: boolean) => {
      paused = p;
      toggle.setAttribute('aria-pressed', String(p));
      label.textContent = p ? 'Přehrát video' : 'Pozastavit video';
    };

    const load = () => {
      if (frame) return;
      frame = document.createElement('iframe');
      const params = new URLSearchParams({
        autoplay: '1',
        mute: '1',
        loop: '1',
        playlist: id,
        controls: '0',
        disablekb: '1',
        modestbranding: '1',
        playsinline: '1',
        rel: '0',
        iv_load_policy: '3',
        enablejsapi: '1',
        origin: location.origin,
      });
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?${params}`;
      frame.title = 'Úvodní video Krakonošova cyklomaratonu';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture';
      frame.tabIndex = -1;
      frame.setAttribute('aria-hidden', 'true');
      frame.addEventListener('load', () => setTimeout(() => media.classList.add('is-playing'), 1400));
      media.insertBefore(frame, media.querySelector('.scrim'));
    };

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

    if (reduce || saveData) {
      setPaused(true);
    } else if (document.readyState === 'complete') {
      load();
    } else {
      window.addEventListener('load', load, { once: true });
    }

    toggle.addEventListener('click', () => {
      if (!frame) {
        load();
        setPaused(false);
        return;
      }
      command(paused ? 'playVideo' : 'pauseVideo');
      setPaused(!paused);
    });
  }
</script>
