---
import { Image } from 'astro:assets';
import { getPosts, postDateShort, postUrl } from '../lib/news';

interface Props {
  limit?: number;
  headingLevel?: 'h2' | 'h3';
}
const { limit = 6, headingLevel: H = 'h3' } = Astro.props;
const posts = (await getPosts()).slice(0, limit);
const [lead, ...rest] = posts;
---

<div class="news">
  {
    lead && (
      <article class="lead">
        <a href={postUrl(lead)} class="lead-link">
          <div class="lead-img">
            <Image src={lead.data.image} alt={lead.data.imageAlt} widths={[480, 800, 1200]} sizes="(max-width: 60rem) 100vw, 55vw" />
          </div>
          <time class="date t-label num" datetime={lead.data.date.toISOString().slice(0, 10)}>
            {postDateShort(lead)}
          </time>
          <H class="lead-title">{lead.data.title}</H>
          <p class="excerpt">{lead.data.excerpt}</p>
        </a>
      </article>
    )
  }
  <ol class="list">
    {
      rest.map((p) => (
        <li>
          <a href={postUrl(p)} class="item">
            <span class="thumb">
              <Image src={p.data.image} alt="" widths={[200, 400]} sizes="9rem" />
            </span>
            <span class="meta">
              <time class="date t-label num" datetime={p.data.date.toISOString().slice(0, 10)}>
                {postDateShort(p)}
              </time>
              <H class="item-title">{p.data.title}</H>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .news {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .lead-link,
  .item {
    color: inherit;
    text-decoration: none;
  }

  .lead-img {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--ridge-100);
  }

  .lead-img :global(img),
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .lead-link:hover :global(img),
  .item:hover :global(img) {
    transform: scale(1.035);
  }

  .date {
    display: block;
    color: var(--ink-3);
  }

  .lead .date {
    margin-top: 1.5rem;
  }

  .lead-title {
    margin-top: 0.6rem;
    font-stretch: 70%;
    font-weight: 800;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.02;
    max-width: 24ch;
  }

  .excerpt {
    margin-top: 1rem;
    color: var(--ink-2);
    max-width: 52ch;
  }

  .lead-link:hover .lead-title,
  .item:hover .item-title {
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  .list {
    list-style: none;
    border-top: 1.5px solid var(--ink);
  }

  .list li {
    border-bottom: 1px solid var(--line);
  }

  .item {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1.25rem;
    align-items: center;
    padding-block: 1.1rem;
  }

  .thumb {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--ridge-100);
  }

  .item-title {
    margin-top: 0.35rem;
    font-stretch: 80%;
    font-weight: 720;
    font-size: 1.1875rem;
    line-height: 1.15;
  }

  @media (max-width: 60rem) {
    .news {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 30rem) {
    .item {
      grid-template-columns: 5.5rem 1fr;
      gap: 1rem;
    }

    .item-title {
      font-size: 1.0625rem;
    }
  }
</style>
