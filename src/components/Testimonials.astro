---
import { Image } from 'astro:assets';
import { testimonials } from '../data/race';
import splits from '../data/splits-2026.json';

const riders = import.meta.glob<{ default: ImageMetadata }>('../assets/riders/*.png', { eager: true });
const portraits = Object.keys(riders)
  .sort()
  .map((k) => riders[k].default);

const finishers = splits.stats.long.finishers + splits.stats.short.finishers;
const [featured, ...rest] = [testimonials[1], ...testimonials.filter((_, i) => i !== 1)];
---

<div class="voices">
  <div class="intro">
    <h2 class="t-title">13 let pozitivních ohlasů</h2>
    <p class="t-lede">Deset ročníků a tisíce spokojených cyklonadšenců, amatérů i profesionálů.</p>
    <p class="stat num">
      V roce 2026 dojelo do cíle <strong>{finishers} závodníků</strong>: {splits.stats.long.finishers} na dlouhé a {splits.stats.short.finishers} na krátké trati.
    </p>
    <div class="faces">
      {portraits.map((src) => <Image src={src} alt="Účastník Krakonošova cyklomaratonu" widths={[200, 360]} sizes="(max-width: 60rem) 25vw, 12vw" />)}
    </div>
  </div>

  <div class="quotes">
    <figure class="q featured">
      <blockquote><p>{featured.quote}</p></blockquote>
      <figcaption>
        <b>{featured.name}</b>
        {featured.note && <span>{featured.note}</span>}
      </figcaption>
    </figure>
    {
      rest.map((t) => (
        <figure class="q">
          <blockquote>
            <p>{t.quote}</p>
          </blockquote>
          <figcaption>
            <b>{t.name}</b>
            {t.note && <span>{t.note}</span>}
          </figcaption>
        </figure>
      ))
    }
  </div>
</div>

<style>
  .voices {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .intro {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .stat {
    color: var(--ink-2);
  }

  .stat strong {
    color: var(--ink);
  }

  .faces {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    margin-top: 1rem;
  }

  .faces :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: saturate(0.9);
  }

  .quotes {
    columns: 2 18rem;
    column-gap: clamp(2rem, 4vw, 3.5rem);
  }

  .q {
    break-inside: avoid;
    margin: 0 0 2.25rem;
    padding-top: 1rem;
    border-top: 1.5px solid var(--ink);
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    font-size: 1.125rem;
    line-height: 1.5;
  }

  .featured blockquote p {
    font-stretch: 85%;
    font-weight: 560;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.35;
  }

  figcaption {
    display: grid;
    margin-top: 0.9rem;
    line-height: 1.3;
  }

  figcaption b {
    font-stretch: 72%;
    font-weight: 780;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  figcaption span {
    color: var(--ink-3);
    font-size: 0.9375rem;
  }

  @media (max-width: 60rem) {
    .voices {
      grid-template-columns: 1fr;
    }
  }
</style>
