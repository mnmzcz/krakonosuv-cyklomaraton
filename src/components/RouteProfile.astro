    pointer-events: none;
  }

  .svc {
    position: absolute;
    top: 0;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    transform: translateX(-50%);
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 50%;
  }

  .svc.bottle {
    transform: translateX(-50%) translateY(-2.1rem);
  }

  .svc :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  /* scrub */
  .rb-scrub {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--label-band) + var(--climb-band));
    height: var(--plot-h);
    cursor: crosshair;
    touch-action: pan-y;
  }

  .rb-scrub:focus-visible {
    outline-offset: 6px;
  }

  .rb-cursor {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0;
    border-left: 1.5px solid var(--red);
    pointer-events: none;
  }

  .rb-dot {
    position: absolute;
    left: -6.5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 3px var(--paper);
    transform: translateY(-50%);
  }

  /* the readout lives inside the plot, beside the cursor; it never touches the label band */
  .rb-read {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    gap: 0.1rem;
    padding: 0.4rem 0.6rem 0.4rem;
    background: var(--ink);
    color: #fff;
    border-radius: 2px;
    box-shadow: 0 6px 18px -8px rgba(6, 18, 33, 0.45);
    white-space: nowrap;
    pointer-events: none;
  }

  .rb-read[hidden] {
    display: none;
  }

  .rd-top {
    font-stretch: 75%;
    font-weight: 650;
    font-size: 0.9375rem;
    line-height: 1.2;
  }

  .rd-name {
    font-stretch: 66%;
    font-weight: 760;
    font-size: 0.8125rem;
    line-height: 1.1;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ridge-200);
