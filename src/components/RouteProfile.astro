  .rd-name:empty {
    display: none;
  }

  /* foot */
  .rb-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .rb--chart-first .rb-foot {
    margin-top: 1.25rem;
  }

  .rb-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .rb-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .rb-legend :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .sw {
    width: 1.1rem;
    height: 0.75rem;
    border-radius: 1px;
  }

  .sw.g1 {
    background: var(--grade-1);
  }
  .sw.g2 {
    background: var(--grade-2);
  }
  .sw.g3 {
    background: var(--grade-3);
  }

  .sw-bracket {
    width: 1.35rem;
    height: 0.45rem;
    border: 1.5px solid var(--ink-2);
    border-bottom: 0;
    transform: translateY(0.1rem);
  }

  /* the climbs: beside the heading and lede (chart-first), or under the legend */
  .rb-lead {
    display: grid;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .rb-h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6rem;
    margin-bottom: 0.9rem;
    font-stretch: 72%;
    font-weight: 780;
    text-transform: uppercase;
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1;
  }

  .rb-h3-sub {
    font-weight: 560;
    font-size: 0.65em;
    color: var(--ink-3);
  }

  .rb-climbs table {
    width: 100%;
  }

  .rb-climbs th,
  .rb-climbs td {
    padding: 0.6rem 0.75rem 0.6rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: baseline;
  }

  .rb-climbs th:last-child,
  .rb-climbs td:last-child {
    padding-right: 0;
  }

  .rb-climbs thead th {
    padding-block: 0 0.5rem;
    border-bottom: 1.5px solid var(--ink);
    font-stretch: 66%;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.75rem;
    line-height: 1.15;
    color: var(--ink-3);
    vertical-align: bottom;
  }

  .rb-climbs .n {
    text-align: right;
  }

  .rb-climbs tbody th {
    font-weight: 400;
  }

  .rb-climbs tbody th b {
    display: block;
    font-stretch: 72%;
    font-weight: 760;
    text-transform: uppercase;
    font-size: 1.0625rem;
    line-height: 1.1;
  }

  .rb-climbs .span {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .rb-climbs td {
    font-stretch: 80%;
    font-weight: 650;
    font-size: 1.0625rem;
    white-space: nowrap;
  }

  /* places table */
  .rb-table {
    margin-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .rb--default .rb-table {
    margin-top: 1.75rem;
  }

  .rb-table summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-block: 0.6rem;
    cursor: pointer;
    list-style: none;
    font-stretch: 75%;
    font-weight: 720;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .rb-table summary::-webkit-details-marker {
    display: none;
  }

  .rb-table summary:hover span {
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-underline-offset: 0.2em;
  }

  .rb-table summary :global(.rb-chev) {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    transition: transform 0.3s var(--ease-out);
  }

  .rb-table[open] summary :global(.rb-chev) {
    transform: rotate(180deg);
  }

  .rb-table table {
    width: 100%;
    max-width: 40rem;
    margin-bottom: 1rem;
  }

  .rb-table th,
  .rb-table td {
    padding: 0.45rem 1rem 0.45rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }

  .rb-table th {
    font-stretch: 75%;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .rb-table td:first-child,
  .rb-table td:last-child {
    width: 5rem;
  }

  .note {
    color: var(--ink-3);
  }

  /* the ride: the profile is drawn left to right once, stems and climbs land as it passes */
  :global(.js) .rb-route .rb-svg {
    clip-path: inset(0 100% 0 0);
  }

  :global(.js) .rb-route .rb-mark,
  :global(.js) .rb-route .svc,
  :global(.js) .rb-route .rb-bracket {
    opacity: 0;
  }

  :global(.js) .rb-chart.is-in .rb-svg {
    clip-path: inset(0 0 0 0);
    transition: clip-path 1.9s var(--ease-out);
  }

  :global(.js) .rb-chart.is-in .rb-mark,
  :global(.js) .rb-chart.is-in .svc,
  :global(.js) .rb-chart.is-in .rb-bracket {
    opacity: 1;
    transition: opacity 0.5s var(--ease-out);
    transition-delay: var(--t, 0s);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .rb-route .rb-svg {
      clip-path: none;
    }
    :global(.js) .rb-route .rb-mark,
    :global(.js) .rb-route .svc,
    :global(.js) .rb-route .rb-bracket {
      opacity: 1;
    }
  }

  @media (max-width: 75rem) {
    .rb-stage.has-tabs {
      grid-template-columns: minmax(0, 1fr);
    }

    .rb-stage.has-tabs .rb-tabs {
      border-bottom: 1px solid var(--line);
    }

    .rb-stage.has-tabs .rb-tabs label:last-of-type {
      border-right: 0;
    }

    .rb-stage.has-tabs .rb-fact:first-child {
      padding-left: 0;
    }
  }

  @media (max-width: 60rem) {
    .rb-bracket.is-tight .num {
      display: none;
    }

    .rb--chart-first {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'chart' 'stage' 'note' 'foot' 'copy' 'climbs' 'table';
    }
  }

  @media (max-width: 48rem) {
    .rb {
      --label-band: 7.5rem;
    }

    .rb-chart.has-climbs {
      --climb-band: 0.9rem;
    }

    .rb-bracket {
      bottom: 0.15rem;
      height: 0.35rem;
    }

    .rb-bracket .num {
      display: none;
    }

    .tier-2 {
      display: none;
    }

    .rb-name .num {
      display: none;
    }

    .rb-tabs label {
      flex: 1;
      flex-wrap: wrap;
      padding: 0.75rem 0.85rem;
    }

    .rb-tabs label:last-of-type {
      border-right: 0;
    }

    .tab-km {
      flex-basis: 100%;
      padding-left: 2.4rem;
    }

    .rb-facts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rb-fact {
      padding: 0.6rem 0 0.65rem;
    }

    .rb-fact + .rb-fact {
      border-left: 0;
    }

    .rb-fact:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .rb-fact:nth-child(even) {
      padding-left: 1rem;
      border-left: 1px solid var(--line);
    }

    .rb-fact:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    .rb-fact .v {
      font-size: 1.25rem;
    }

    .tick:not(.major) {
      display: none;
    }

    .svc {
      width: 1.4rem;
      height: 1.4rem;
    }

    .svc.bottle {
      transform: translateX(-50%) translateY(-1.65rem);
    }

    .svc :global(svg) {
      width: 0.85rem;
      height: 0.85rem;
    }

    .tick.major:nth-of-type(4n + 3) span {
      display: none;
    }

    .rb-climbs th,
    .rb-climbs td {
      padding-right: 0.5rem;
    }

    .rb-climbs tbody th b {
      font-size: 0.9375rem;
    }

    .rb-climbs td {
      font-size: 0.9375rem;
    }

    .rb-climbs .span {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  type ChartData = { L: number; p: [number, number][]; w: [number, number, string][] };

  const fmt = (n: number, d = 0) => n.toLocaleString('cs-CZ', { minimumFractionDigits: d, maximumFractionDigits: d });

  document.querySelectorAll<HTMLElement>('[data-chart]').forEach((chart) => {
    const data: ChartData = JSON.parse(chart.dataset.chart!);
    const scrub = chart.querySelector<HTMLElement>('.rb-scrub')!;
    const cursor = chart.querySelector<HTMLElement>('.rb-cursor')!;
    const dot = chart.querySelector<HTMLElement>('.rb-dot')!;
    const read = chart.querySelector<HTMLElement>('.rb-read')!;
    const readTop = read.querySelector<HTMLElement>('.rd-top')!;
    const readName = read.querySelector<HTMLElement>('.rd-name')!;
    const ALT_MIN = 300;
    const ALT_MAX = 1150;
    const pts = data.p;

    // binary search: 675 samples, called on every pointer move
    const altAt = (km: number) => {
      let lo = 0;
      let hi = pts.length - 1;
      if (km <= pts[0][0]) return pts[0][1];
      if (km >= pts[hi][0]) return pts[hi][1];
      while (hi - lo > 1) {
        const mid = (lo + hi) >> 1;
        if (pts[mid][0] <= km) lo = mid;
        else hi = mid;
      }
      const [k0, a0] = pts[lo];
      const [k1, a1] = pts[hi];
      return a0 + ((a1 - a0) * (km - k0)) / (k1 - k0 || 1);
    };

    let km = 0;
    const show = (value: number) => {
      km = Math.max(0, Math.min(data.L, value));
      const line = altAt(km);
      const near = data.w.find((w) => Math.abs(w[0] - km) <= Math.max(0.9, data.L / 150));
      const alt = near ? near[1] : line;
      const x = (km / data.L) * 100;
      const yf = 1 - (line - ALT_MIN) / (ALT_MAX - ALT_MIN);
      cursor.hidden = false;
      read.hidden = false;
      cursor.style.left = `${x}%`;
      dot.style.top = `${yf * 100}%`;
      readTop.textContent = `km ${fmt(km, 1)} · ${fmt(alt)} m`;
      readName.textContent = near ? near[2] : '';

      // beside the cursor, flipping sides near the edges; above or below the dot, inside the plot
      const W = scrub.clientWidth;
      const H = scrub.clientHeight;
      const rw = read.offsetWidth;
      const rh = read.offsetHeight;
      const cx = (x / 100) * W;
      const cy = yf * H;
      const gap = 12;
      let left = cx + gap;
      if (left + rw > W) left = cx - gap - rw;
      if (left < 0) left = Math.max(0, Math.min(W - rw, cx - rw / 2));
      let top = cy < H * 0.45 ? cy + gap + 4 : cy - gap - 4 - rh;
      top = Math.max(4, Math.min(H - rh - 4, top));
      read.style.transform = `translate(${Math.round(left)}px, ${Math.round(top)}px)`;

      scrub.setAttribute('aria-valuenow', String(Math.round(km)));
      scrub.setAttribute('aria-valuetext', `km ${fmt(km, 1)}, ${fmt(alt)} metrů${near ? `, ${near[2]}` : ''}`);
    };

    const hide = () => {
      cursor.hidden = true;
      read.hidden = true;
    };

    const fromPointer = (e: PointerEvent) => {
      const r = scrub.getBoundingClientRect();
      show(((e.clientX - r.left) / r.width) * data.L);
    };

    scrub.addEventListener('pointermove', fromPointer);
    scrub.addEventListener('pointerdown', fromPointer);
    scrub.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse' && document.activeElement !== scrub) hide();
    });
    scrub.addEventListener('focus', () => show(km));
    scrub.addEventListener('blur', hide);
    scrub.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 10 : 1;
      const keys: Record<string, number> = {
        ArrowRight: km + step,
        ArrowUp: km + step,
        ArrowLeft: km - step,
        ArrowDown: km - step,
        PageUp: km + 10,
        PageDown: km - 10,
        Home: 0,
        End: data.L,
      };
      if (e.key in keys) {
        e.preventDefault();
        show(keys[e.key]);
      }
    });
  });

  // the ride: reveal once when the chart comes into view
  const charts = document.querySelectorAll<HTMLElement>('.rb-chart');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((en) => {
          if (en.isIntersecting) {
            en.target.classList.add('is-in');
            io.unobserve(en.target);
          }
        }),
      { threshold: 0.35 },
    );
    charts.forEach((c) => io.observe(c));
    // a route revealed by the switch is already in view
    document.querySelectorAll<HTMLInputElement>('.rb-tabs input').forEach((input) =>
      input.addEventListener('change', () => {
        const rb = input.closest('[data-rb]')!;
        rb.querySelectorAll('.rb-chart').forEach((c) => {
          c.classList.remove('is-in');
          requestAnimationFrame(() => requestAnimationFrame(() => c.classList.add('is-in')));
        });
      }),
    );
  } else {
    charts.forEach((c) => c.classList.add('is-in'));
  }
</script>
