      { label: 'Photopoint: Pomezní sedlo', href: 'https://eu.zonerama.com/krakonosuvcyklomaraton/Album/9941449' },
    ],
  },
  {
    year: 2022,
    cover: c2022,
    albums: [
      { label: 'Foto: Miloš Šálek', href: 'https://eu.zonerama.com/krakonosuvcyklomaraton/Album/8551925' },
