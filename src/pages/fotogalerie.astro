    ],
  },
  {
    year: 2025,
    cover: c2025,
    albums: [
      { label: 'Krakonošův cyklomaraton 2025 (Miloš Šálek)', href: 'https://photos.app.goo.gl/WTs9pTmFF4VcQF3fA' },
      { label: 'Krakonošův cyklomaraton 2025 (Tomáš Šálek)', href: 'https://photos.app.goo.gl/QfYrcmRw9uAWTgme8' },
      { label: 'Krakonošův cyklomaraton 2025 (Martin Korhel)', href: 'https://photos.app.goo.gl/m2VDnqJZbgxsaSc7A' },
      { label: 'Photopoint pomezní sedlo', href: 'https://photos.app.goo.gl/95Lhyt7wi7Trtwi68' },
    ],
  },
  {
    year: 2024,
    cover: c2024,
    albums: [
      { label: 'Photopoint pomezní sedlo', href: 'https://photos.app.goo.gl/m9XBLE1AVW714YRt6' },
      { label: 'Krakonošův cyklomaraton 2024 (Martin Korhel)', href: 'https://photos.app.goo.gl/Hp3iaLbLz1vg6s4P6' },
      { label: 'Krakonošův cyklomaraton 2024 (Miloš Šálek)', href: 'https://photos.app.goo.gl/Q1tWcRFASAeQREiw7' },
      { label: 'Krakonošův cyklomaraton 2024 (Tomáš Šálek)', href: 'https://photos.app.goo.gl/5Yvo817gnvRFxJ1K7' },
      { label: 'Krakonošův cyklomaraton 2024 (Miloš Lubas)', href: 'https://photos.app.goo.gl/BAxMtu6VJ7u3tQ96A' },
