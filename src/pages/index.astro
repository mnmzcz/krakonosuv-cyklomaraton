---
import { getImage, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import RideRail from '../components/RideRail.astro';
import RouteProfile from '../components/RouteProfile.astro';
import PriceClimb from '../components/PriceClimb.astro';
import NewsList from '../components/NewsList.astro';
import Testimonials from '../components/Testimonials.astro';
import PartnerBoard from '../components/PartnerBoard.astro';
import Icon from '../components/Icon.astro';
import JsonLd from '../components/JsonLd.astro';
import { homeSchema } from '../lib/schema';
import ogPhoto from '../assets/photos/horska-silnice.jpg';
import fansPhoto from '../assets/photos/turiste-u-trati.jpg';
import splits from '../data/splits-2026.json';
import data from '../data/routes.json';
import { race } from '../data/race';

const pomezni = splits.spots.find((s) => s.id === 'pomezni')!;
const first = pomezni.window.long!.first;
const last = pomezni.window.short!.last;
const long = data.routes.long;
const short = data.routes.short;
const prazska = long.climbs.find((c) => c.name === 'Pražská bouda')!;
const m = (n: number) => n.toLocaleString('cs-CZ');
// the same 1200 px photo the page shares on social networks
const og = await getImage({ src: ogPhoto, width: 1200, format: 'jpg' });
const schema = homeSchema(Astro.site!, new URL(og.src, Astro.site).href);
const pct = (n: number) => n.toLocaleString('cs-CZ', { maximumFractionDigits: 1 });

// The page is ridden like the long route: each section is a stop at a real place on the road.
const stops = [
  // where the road begins
  { id: 'trat', label: 'Trať', place: 'Trutnov' },
  // the first climb of the day; the price climbs too, deadline by deadline
  { id: 'startovne', label: 'Startovné', place: 'Prkenný Důl' },
  // the spot both routes pass, the one the fans section quotes pass times for
  { id: 'fandit', label: 'Fandit', place: 'Pomezní Boudy' },
  // the roof of the race, where the news comes from the top
  { id: 'aktuality', label: 'Aktuality', place: 'Pražská bouda' },
  // the feed station, where riders stop and talk
  { id: 'ohlasy', label: 'Ohlasy', place: 'Strážné' },
  // the last climb, through one of the towns that back the race
  { id: 'partneri', label: 'Partneři', place: 'Janské Lázně' },
];
---

<Base description={race.pitch}>
  <link slot="head" rel="preconnect" href="https://www.youtube-nocookie.com" />
  <JsonLd slot="head" data={schema} />
  <Hero />
  <RideRail stops={stops} />

  <section class="route" id="trat" aria-labelledby="trat-title">
    <div class="wrap">
      <RouteProfile id="profil-trate" layout="split">
        <h2 class="t-title" id="trat-title">Trať, která prověří každého</h2>
        <p class="t-lede">
          Dlouhá trať má {long.climbs.length} stoupání a {m(long.gain)} m převýšení: z Trutnova přes Polsko na Pomezní Boudy, pak na Pražskou boudu, kde má
          nejprudší kilometr {pct(prazska.max)} %, a přes Strážné a Janské Lázně zpátky. Krátká trať vyjede na Pomezní Boudy a nastoupá {m(short.gain)} m.
        </p>
        <p class="route-note">
          Čísla i profil jsou z tras ročníku 2026; projedete ho kurzorem, prstem nebo šipkami. Trasy pro rok 2027 upřesníme po schválení Policií ČR.
        </p>
      </RouteProfile>
    </div>
  </section>

  <section class="section field-dark" id="startovne" aria-label="Startovné">
    <div class="wrap">
      <PriceClimb />
    </div>
  </section>

  <section class="fans" id="fandit" aria-labelledby="fans-title">
    <div class="fans-img">
      <Image src={fansPhoto} alt="Závodníci stoupají horskou loukou, u silnice stojí turisté" widths={[640, 1024, 1500]} sizes="(max-width: 60rem) 100vw, 55vw" />
    </div>
    <div class="fans-copy">
      <h2 class="t-title" id="fans-title">Přijďte fandit</h2>
      <p class="t-lede">
        Nahoře na Pomezních Boudách a pod Pražskou boudou potřebují závodníci povzbudit nejvíc. Kde stát, kdy pojedou a jak se tam dostat: podle mezičasů ročníku 2026 projelo čelo závodu Pomezní Boudy v {first}, poslední závodníci krátké trati v {last}.
      </p>
      <a class="link-arrow" href="/fanousci/">Průvodce pro fanoušky <Icon name="arrow" /></a>
    </div>
  </section>

  <section class="section" id="aktuality" aria-labelledby="aktuality-title">
    <div class="wrap">
      <div class="section-head head-row">
        <h2 class="t-title" id="aktuality-title">Aktuality</h2>
        <a class="link-arrow" href="/aktuality/">Všechny aktuality <Icon name="arrow" /></a>
      </div>
      <NewsList />
    </div>
  </section>

  <section class="section field-paper voices" id="ohlasy" aria-label="Ohlasy závodníků">
    <div class="wrap">
      <Testimonials />
    </div>
  </section>

  <section class="section partners" id="partneri" aria-label="Partneři">
    <div class="wrap">
      <PartnerBoard />
    </div>
  </section>
</Base>

<style>
  /* the road book opens with its heading right under the hero ridge; its profile keeps the same km scale */
  /* The road book opens on a fresh sheet: paper under a 3px ink rule, so the hero's ridge (which
     shows the same road) ends with the hero instead of running on into the section. */
  .route {
    padding-top: clamp(3.5rem, 7vw, 6rem);
    padding-bottom: var(--space-section);
    background: var(--paper);
    border-top: 3px solid var(--ink);
  }

  /* which year the numbers come from: said once, quietly, under the lede */
  .route-note {
    max-width: 60ch;
    color: var(--ink-3);
    font-size: 0.9375rem;
  }

  .fans {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    background: var(--ridge-100);
  }

  .fans-img {
    min-height: 28rem;
  }

  .fans-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fans-copy {
    display: grid;
    gap: 1.5rem;
    align-content: center;
    justify-items: start;
    padding: clamp(3rem, 7vw, 6rem) var(--gutter);
    max-width: 38rem;
  }

  .head-row {
    grid-template-columns: 1fr auto;
    align-items: end;
  }

  .voices {
    border-bottom: 1px solid var(--line);
  }

  .partners {
    background: var(--paper);
  }

  @media (max-width: 60rem) {
    .fans {
      grid-template-columns: 1fr;
    }

    .fans-img {
      min-height: 0;
      aspect-ratio: 3 / 2;
    }
  }
</style>
