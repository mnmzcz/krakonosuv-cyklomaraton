---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import RouteProfile from '../components/RouteProfile.astro';
import RouteMap from '../components/RouteMap.astro';
import Icon from '../components/Icon.astro';
import headPhoto from '../assets/photos/sjezd-peloton.jpg';
import routes from '../data/routes.json';
import splits from '../data/splits-2026.json';
import { program, programNote, race } from '../data/race';

const long = routes.routes.long;
const fmtKm = (n: number) => n.toLocaleString('cs-CZ', { maximumFractionDigits: 1 });
const fmtInt = (n: number) => n.toLocaleString('cs-CZ').replace(/\s/g, '\u00a0');

// every spectator spot stands at a place of the long route's road book
const PLACE: Record<string, string> = {
  start: 'Trutnov',
  prkenny: 'Prkenný Důl',
  lubawka: 'Lubawka',
  pomezni: 'Pomezní Boudy',
  prazska: 'Pražská bouda',
  strazne: 'Strážné',
  janske: 'Janské Lázně',
  cil: 'Trutnov',
};
const wp = (name: string, km = 0) => {
  const found = long.waypoints.filter((w) => w.name === name);
  if (!found.length) throw new Error(`fanousci: waypoint "${name}" is missing in routes.json`);
  return found.reduce((b, w) => (Math.abs(w.km - km) < Math.abs(b.km - km) ? w : b));
};

// kilometres and altitudes in the notes come from the same route data as the timetable and the profile
const notes: Record<string, string> = {
  start:
    'Slavnostní start obou tratí u Společenského centra UFFO. Následují cca 3 km neutrální jízdy za zaváděcím vozidlem, ostrý start je za železničním přejezdem na Polské ulici.',
  prkenny: `První stoupání závodu, vrchol nad Žacléřem na km ${fmtKm(wp('Prkenný Důl').km)}.`,
  lubawka: `Závod projíždí polským městečkem a jeho náměstím (km ${fmtKm(wp('Lubawka').km)}).`,
  pomezni: `Nejvyšší bod krátké trati (${fmtInt(wp('Pomezní Boudy').alt)} m) na česko-polské hranici. Kontrola, bufet a Photopoint; projíždějí tudy obě tratě.`,
  prazska: `Vrchol dlouhé trati (${fmtInt(wp('Pražská bouda').alt)} m) po stoupání z Pece pod Sněžkou. Úsek Pec pod Sněžkou – Pražská bouda – Černý Důl má zákaz vjezdu, nahoru jen pěšky nebo na kole.`,
  strazne: `Bufet dlouhé trati na km ${fmtKm(wp('Strážné').km)}.`,
  janske: `Poslední velké stoupání dlouhé trati, z Lánova (km ${fmtKm(wp('Lánov').km)}) do Janských Lázní (km ${fmtKm(wp('Janské Lázně').km)}).`,
  cil: 'Cílová brána u UFFO. Vyhlášení výsledků a tombola v 16:00.',
};

const toMin = (t: string) => {
  const [h, m] = t.split(':').map(Number);
  return h * 60 + m;
};
const T0 = 10 * 60;
const T1 = 17 * 60;
const pos = (t: string) => ((toMin(t) - T0) / (T1 - T0)) * 100;
const hours = Array.from({ length: 8 }, (_, i) => ({ label: `${10 + i}:00`, x: (i / 7) * 100, odd: i % 2 === 1 && i < 7 }));

const nearPoint = (km: number) =>
  long.points.reduce((b, p) => (Math.abs(p[0] - km) < Math.abs(b[0] - km) ? p : b));
const mapLink = (km: number) => {
  const p = nearPoint(km);
  return `https://mapy.com/fnc/v1/showmap?mapset=outdoor&center=${p[3]},${p[2]}&zoom=14&marker=true`;
};

const spots = splits.spots.map((s, i) => {
  const w = s.window as Record<string, { km: number; first: string; last: string }>;
  const km = s.km as Record<string, number>;
  const kmA = km.long ?? km.short;
  const place = wp(PLACE[s.id] ?? s.name, kmA);
  if (Math.abs(place.km - kmA) > 0.3) console.warn(`fanousci: ${s.name} is km ${kmA} in splits but km ${place.km} in routes.json`);
  return {
    ...s,
    n: i + 1,
    kmA,
    place,
    route: (km.long !== undefined ? 'long' : 'short') as 'long' | 'short',
    note: notes[s.id],
    map: mapLink(kmA),
    bars: (['long', 'short'] as const)
      .filter((r) => w[r])
      .map((r) => ({
        route: r,
        km: w[r].km,
        first: w[r].first,
        last: w[r].last,
        x: pos(w[r].first),
        w: Math.max(0, pos(w[r].last) - pos(w[r].first)),
      })),
  };
});

// profile markers: km from the timetable, altitude from the long route's waypoint of the same name;
// start and finish share Trutnov, so each end carries its own label
const markers = spots.map((s, i, all) => ({
  km: s.kmA,
  name: i === 0 ? `Start ${s.place.name}` : i === all.length - 1 ? `Cíl ${s.place.name}` : s.place.name,
  alt: s.place.alt,
  tier: 1 as const,
  kind: 'spot' as const,
}));

const mapSpots = spots.map((s) => ({ n: s.n, name: s.place.name, km: s.kmA, route: s.route }));
---

<Base title="Fanoušci" description="Kde fandit na Krakonošově cyklomaratonu, kdy kudy pojedou závodníci, program v Trutnově a doprava v den závodu.">
  <PageHead
    title="Fanoušci"
    lede="Krakonošův cyklomaraton se jede na otevřených silnicích východních Krkonoš. Fandit můžete na startu v Trutnově, na stoupáních i v cíli. Tady najdete kde, kdy a jak se tam dostat."
    image={headPhoto}
    imagePosition="50% 40%"
    mark={{ name: 'Pomezní Boudy', km: wp('Pomezní Boudy').km }}
  >
    <nav class="jump on-dark" aria-label="Na této stránce">
      <a class="btn btn--ghost btn--small" href="#kde-fandit">Kde fandit</a>
      <a class="btn btn--ghost btn--small" href="#program">Program v Trutnově</a>
      <a class="btn btn--ghost btn--small" href="#doprava">Doprava a uzavírky</a>
    </nav>
  </PageHead>

  <section class="section" id="kde-fandit" aria-labelledby="kde-title">
    <div class="wrap">
      <div class="section-head">
        <h2 class="t-title" id="kde-title">Kde fandit</h2>
        <p class="t-lede">
          Osm míst na trati, kde je na co koukat. Časy vycházejí z mezičasů ročníku {splits.year}: start dlouhé trati v 10:00, krátké v 10:05. Na Pomezních
          Boudách, Pražské boudě a v cíli se měřilo, ostatní místa jsme dopočítali.
        </p>
      </div>

      <RouteProfile id="fans-profile" routes={['long']} markers={markers} stats={false} table={false} />

      <div class="spots">
        <div class="spots-map">
          <RouteMap id="fans-map" spots={mapSpots} />
        </div>

        <div class="spots-table">
          <div class="timetable" role="table" aria-label={`Průjezdní časy podle ročníku ${splits.year}`}>
            <div class="tt-row tt-head" role="row">
              <span role="columnheader" class="t-label">Místo</span>
              <span role="columnheader" class="t-label">km</span>
              <span role="columnheader" class="t-label tt-axis-head">
                <span class="visually-hidden">Okno průjezdu</span>
                <span class="hours" aria-hidden="true">
                  {hours.map((h) => <span style={`left:${h.x}%`} class:list={['num', { odd: h.odd }]}>{h.label}</span>)}
                </span>
              </span>
            </div>

            {
              spots.map((s) => (
                <div class="tt-row" role="row">
                  <div role="cell" class="tt-place">
                    <h3 class="tt-name">
                      <span class="tt-n num">
                        {s.n}<span class="visually-hidden">.</span>
                      </span>
                      <span>{s.name}</span>
                    </h3>
                    <p class="tt-note">{s.note}</p>
                    <a class="tt-map" href={s.map} target="_blank" rel="noopener">
                      <Icon name="pin" /> Na mapě
                    </a>
                  </div>
                  <div role="cell" class="tt-km num">
                    {s.bars.map((b) => (
                      <span>
                        {fmtKm(b.km)}
                        <abbr title={b.route === 'long' ? 'dlouhá trať' : 'krátká trať'}>{b.route === 'long' ? 'A' : 'B'}</abbr>
                      </span>
                    ))}
                  </div>
                  <div role="cell" class="tt-bars">
                    {s.bars.map((b) => (
                      <div class:list={['bar-line', b.route]}>
                        <span
                          class:list={['bar', { measured: s.measured, point: b.w === 0 }]}
                          style={`left:${b.x}%;width:${b.w}%`}
                          aria-hidden="true"
                        />
                        <span class="bar-text num" style={`left:${b.x}%`}>
                          <abbr title={b.route === 'long' ? 'dlouhá trať' : 'krátká trať'}>{b.route === 'long' ? 'A' : 'B'}</abbr>
                          {b.first === b.last ? b.first : `${b.first} – ${b.last}`}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>

          <ul class="tt-legend">
            <li><i class="lg measured" />měřeno v roce {splits.year} (první až poslední závodník)</li>
            <li><i class="lg" />dopočteno mezi měřenými body</li>
            <li><b>A</b> dlouhá trať · <b>B</b> krátká trať</li>
          </ul>
          <p class="source">
            Zdroj: <a href="https://vysledky.sportsoft.cz/race/805" target="_blank" rel="noopener">oficiální výsledky {splits.date}, SportSoft</a>. Časy pro
            rok {race.year} se budou lišit podle počasí a tempa pole.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section field-dark" id="program" aria-labelledby="program-title">
    <div class="wrap program-grid">
      <div class="section-head">
        <h2 class="t-title" id="program-title">Program v Trutnově</h2>
        <p class="t-lede">
          Start, cíl a celé zázemí závodu je u Společenského centra UFFO na Náměstí Republiky 999. Dopoledne patří dětským závodům, odpoledne dojezdům a
          vyhlášení.
        </p>
        <a class="link-arrow on-dark-link" href={race.venueMap} target="_blank" rel="noopener">UFFO na mapě <Icon name="external" /></a>
      </div>
      <div class="days">
        {
          program.map((d) => (
            <div class="day">
              <h3 class="t-sub day-title">{d.day}</h3>
              <ol class="slots">
                {d.items.map((it) => (
                  <li class:list={{ key: 'key' in it && it.key }}>
                    <span class="slot-time num">{it.time}</span>
                    <span class="slot-what">{it.what}</span>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
        <p class="prog-note">{programNote}</p>
      </div>
    </div>
  </section>

  <section class="section" id="doprava" aria-labelledby="doprava-title">
    <div class="wrap">
      <div class="section-head">
        <h2 class="t-title" id="doprava-title">Doprava a uzavírky</h2>
        <p class="t-lede">Silnice se kvůli závodu neuzavírají. Na co si dát pozor, když se vydáte za závodem.</p>
      </div>
      <dl class="travel">
        <div>
          <dt>Závod se jede za plného provozu</dt>
          <dd>
            Na křižovatkách a nebezpečných místech řídí provoz pořadatelé, na exponovaných místech i Policie ČR. Pokud jedete autem po trati, počítejte s
            cyklisty na silnici a řiďte se pokyny pořadatelů.
          </dd>
        </div>
        <div>
          <dt>Na Pražskou boudu jen pěšky nebo na kole</dt>
          <dd>Na úseku Pec pod Sněžkou – Pražská bouda – Černý Důl platí zákaz vjezdu a Policie ČR ho v den závodu striktně hlídá.</dd>
        </div>
        <div>
          <dt>Parkování v Trutnově</dt>
          <dd>
            Před UFFO je bezplatné parkoviště (cca 200 aut) a podzemní garáže (cca 60 aut), které slouží hlavně závodníkům. Po jejich zaplnění využijte okolní
            parkoviště, kde už se platí.
          </dd>
        </div>
        <div>
          <dt>Vlakem a autobusem</dt>
          <dd>Autobusové nádraží je asi 100 m od startu. Kolo můžete nechat v cyklověži přímo na nádraží.</dd>
        </div>
        <div>
          <dt>Semafory před cílem</dt>
          <dd>Na 132. km dlouhé a 85. km krátké trati řídí provoz na semaforech pořadatelé. Počítejte tam s krátkým zdržením.</dd>
        </div>
        <div>
          <dt>U trati</dt>
          <dd>Stůjte mimo vozovku, děti a psy mějte u sebe a silnici nepřebíhejte před přijíždějícími závodníky.</dd>
        </div>
      </dl>
      <p class="source">Podrobné dopravní informace k ročníku {race.year} zveřejníme v předstartovních informacích.</p>
    </div>
  </section>

  <section class="section field-dark close" aria-labelledby="close-title">
    <div class="wrap close-inner">
      <h2 class="t-title" id="close-title">Příště na startu?</h2>
      <p class="t-lede">Fandit je skvělé, jet je lepší. Registrace na {race.edition}. ročník je otevřená a teď je startovné nejlevnější.</p>
      <a class="btn" href="/registrace/">Registrace <Icon name="arrow" /></a>
    </div>
  </section>
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  /* map and timetable: the pins on the map carry the row numbers */
  .spots {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .spots-map {
    max-width: 46rem;
  }

  @media (min-width: 80rem) {
    .spots {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
      align-items: start;
    }

    .spots-map {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
      max-width: none;
    }

    .spots-table {
      grid-column: 1;
      grid-row: 1;
    }

    .spots .tt-row {
      grid-template-columns: minmax(13rem, 4fr) 4rem minmax(0, 6.5fr);
      gap: 1.25rem;
    }

    /* a narrower time axis keeps every other hour */
    .spots .hours .odd {
      display: none;
    }
  }

  /* timetable: the road book's "horaire probable" */
  .timetable {
    border-top: 1.5px solid var(--ink);
  }

  .tt-name {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .tt-n {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--red);
    color: #fff;
    font-stretch: 75%;
    font-weight: 800;
    font-size: 0.875rem;
    line-height: 1;
  }

  .tt-row {
    display: grid;
    grid-template-columns: minmax(14rem, 4fr) 4.5rem minmax(0, 7fr);
    gap: 1.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }

  .tt-head {
    padding-block: 0.8rem;
    color: var(--ink-3);
    align-items: end;
  }

  .tt-axis-head {
    position: relative;
    display: block;
    height: 1rem;
  }

  .hours {
    position: absolute;
    inset: 0;
  }

  .hours span {
    position: absolute;
    transform: translateX(-50%);
    font-size: 0.8125rem;
    letter-spacing: 0;
  }

  .hours span:first-child {
    transform: none;
  }

  .hours span:last-child {
    transform: translateX(-100%);
  }

  .tt-name {
    font-stretch: 72%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 1.375rem;
    line-height: 1;
  }

  .tt-note {
    margin-top: 0.5rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.45;
    max-width: 44ch;
  }

  .tt-map {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.6rem;
    font-weight: 650;
    font-size: 0.9375rem;
    text-decoration-color: var(--red);
  }

  .tt-map :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--red);
  }

  .tt-km {
    display: grid;
    gap: 0.6rem;
    padding-top: 0.15rem;
    font-weight: 650;
  }

  .tt-km abbr,
  .bar-text abbr {
    margin-left: 0.25rem;
    text-decoration: none;
    color: var(--ink-3);
    font-weight: 600;
    font-size: 0.8125rem;
  }

  .bar-text abbr {
    margin: 0 0.35rem 0 0;
  }

  .tt-bars {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding-top: 0.15rem;
    background: repeating-linear-gradient(to right, var(--line) 0 1px, transparent 1px calc(100% / 7)) 0 0 / 100% 100%;
    min-height: 100%;
  }

  .bar-line {
    position: relative;
    height: 1.6rem;
  }

  .bar {
    position: absolute;
    top: 0.2rem;
    height: 1.2rem;
    border-radius: 1px;
    background: repeating-linear-gradient(135deg, var(--ridge-300) 0 4px, transparent 4px 8px);
    border: 1.5px solid var(--ridge-500);
  }

  .bar.measured {
    background: var(--ridge-700);
    border-color: var(--ridge-700);
  }

  .short .bar.measured {
    background: var(--ridge-500);
    border-color: var(--ridge-500);
  }

  .bar.point {
    width: 4px !important;
    background: var(--red);
    border-color: var(--red);
  }

  .bar-text {
    position: absolute;
    top: 1.55rem;
    white-space: nowrap;
    font-weight: 650;
    font-size: 0.9375rem;
  }

  .bar-line + .bar-line {
    margin-top: 1.4rem;
  }

  .bar-line:last-child {
    margin-bottom: 1.6rem;
  }

  .tt-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 1.5rem;
    list-style: none;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .tt-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lg {
    width: 1.5rem;
    height: 0.8rem;
    background: repeating-linear-gradient(135deg, var(--ridge-300) 0 4px, transparent 4px 8px);
    border: 1.5px solid var(--ridge-500);
  }

  .lg.measured {
    background: var(--ridge-700);
    border-color: var(--ridge-700);
  }

  .source {
    margin-top: 1rem;
    color: var(--ink-3);
    font-size: 0.9375rem;
    max-width: 70ch;
  }

  /* program */
  .program-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .program-grid .section-head {
    align-content: start;
    justify-items: start;
  }

  .on-dark-link {
    color: #fff;
  }

  .days {
    display: grid;
    gap: 2.5rem;
  }

  .day-title {
    padding-bottom: 0.75rem;
    border-bottom: 1.5px solid var(--on-dark-2);
  }

  .slots {
    list-style: none;
  }

  .slots li {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--on-dark-line);
    color: var(--on-dark-2);
  }

  .slots li.key {
    color: #fff;
  }

  .slot-time {
    font-stretch: 72%;
    font-weight: 780;
    font-size: 1.1875rem;
    color: #fff;
  }

  .slots li.key .slot-time {
    color: #fff;
  }

  .slots li.key .slot-what {
    font-weight: 650;
  }

  .slots li.key .slot-time::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    vertical-align: 0.12em;
    background: var(--red);
  }

  .prog-note {
    color: var(--on-dark-2);
    font-size: 0.9375rem;
  }

  /* travel */
  .travel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(2rem, 5vw, 5rem);
    margin: 0;
  }

  .travel > div {
    padding-block: 1.5rem;
    border-top: 1.5px solid var(--ink);
  }

  .travel dt {
    font-stretch: 72%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 1.375rem;
    line-height: 1.05;
  }

  .travel dd {
    margin: 0.6rem 0 0;
    color: var(--ink-2);
    max-width: 52ch;
  }

  .close-inner {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  @media (max-width: 60rem) {
    .program-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 48rem) {
    .tt-head {
      grid-template-columns: 1fr;
    }

    .tt-head > :not(.tt-axis-head) {
      display: none;
    }

    .tt-row {
      grid-template-columns: 1fr auto;
      gap: 0.75rem 1rem;
    }

    .tt-bars {
      grid-column: 1 / -1;
    }

    .travel {
      grid-template-columns: 1fr;
    }

    .slots li {
      grid-template-columns: 7rem 1fr;
    }
  }
</style>
