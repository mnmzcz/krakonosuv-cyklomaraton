---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import splits from '../data/splits-2026.json';
import routes from '../data/routes.json';

type Link = { label: string; href: string };
// A group of secondary results. With `prefixed`, its label carries the words its link labels
// no longer repeat ("Dětské závody" + "BABY"); screen readers still hear the full name.
// A group without a label keeps its links' full names.
type Group = { label?: string; prefixed?: boolean; links: Link[] };
type Edition = { n: number; date: string; main: Link; groups?: Group[] };

// the main race's results are online; the format is set beside the name, as with the PDFs
const MAIN = 'Hlavní závod';
const editions: Edition[] = [
  {
    n: 13,
    date: '13. června 2026',
    main: { label: MAIN, href: 'https://vysledky.sportsoft.cz/race/805' },
    groups: [
      {
        label: 'Dětské závody',
        prefixed: true,
        links: [
          { label: 'BABY', href: '/docs/Vysledky-deti-BABY.pdf' },
          { label: 'MINI, ŽÁCI I a II', href: '/docs/Vysledky-deti-MINI-ZACI-I-ZACI-II.pdf' },
        ],
      },
    ],
  },
  {
    n: 12,
    date: '14. června 2025',
    main: { label: MAIN, href: 'https://vysledky.sportsoft.cz/race/423' },
    groups: [{ links: [{ label: 'Dětské závody', href: '/docs/Vysledky-deti-2025.pdf' }] }],
  },
  {
    n: 11,
    date: '15. června 2024',
    main: { label: MAIN, href: 'https://vysledky.sportsoft.cz/race/143' },
    groups: [
      {
        label: 'Hlavní závod podle tratí',
        links: [
          { label: '135 km', href: '/docs/Report-Results.pdf' },
          { label: '95 km', href: '/docs/Report-Results-1.pdf' },
        ],
      },
      {
        label: 'Dětské závody',
        links: [
          { label: 'Baby odrážedla', href: '/docs/Baby-odrazedla.pdf' },
          { label: 'Baby kola', href: '/docs/Baby-kola.pdf' },
          { label: 'Mini', href: '/docs/Mini.pdf' },
          { label: 'Žáci I', href: '/docs/Zaci-I.pdf' },
          { label: 'Žáci II', href: '/docs/Zaci-II.pdf' },
        ],
      },
    ],
  },
  { n: 10, date: '17. června 2023', main: { label: MAIN, href: 'https://sportsoft.cz/cs/zavod/results/7638?rid=7156' } },
  { n: 9, date: '18. června 2022', main: { label: MAIN, href: 'https://www.sportsoft.cz/cs/zavod/results/7144?rid=6638&eventid=1' } },
  { n: 8, date: '19. června 2021', main: { label: MAIN, href: 'https://www.sportsoft.cz/cs/zavod/results/5601?rid=5041' } },
  { n: 7, date: '20. června 2020', main: { label: MAIN, href: 'https://www.sportsoft.cz/cs/zavod/results/5193?rid=4612' } },
  { n: 6, date: '15. června 2019', main: { label: MAIN, href: 'https://www.sportsoft.cz/cs/zavod/results/3780?rid=3094' } },
  { n: 5, date: '16. června 2018', main: { label: MAIN, href: 'https://wyniki.b4sport.pl/krakono-v-cyklomaraton/m120.html' } },
  { n: 4, date: '29. července 2017', main: { label: MAIN, href: 'https://www.sportchallenge.cz/cz/krakonosuvcyklomaraton/2017/vysledky' } },
  { n: 3, date: '6. srpna 2016', main: { label: MAIN, href: 'https://www.sportchallenge.cz/cz/krakonosuvcyklomaraton/2016/vysledky' } },
  { n: 2, date: '1. srpna 2015', main: { label: MAIN, href: 'https://www.sportchallenge.cz/cz/krakonosuvcyklomaraton/2015/vysledky' } },
  { n: 1, date: '2. srpna 2014', main: { label: MAIN, href: 'https://www.sportchallenge.cz/cz/krakonosuvcyklomaraton/2014/vysledky' } },
];
const [latest, ...archive] = editions;
const year = (e: Edition) => e.date.slice(-4);
const winners = [
  { route: 'Dlouhá trať', ...splits.stats.long },
  { route: 'Krátká trať', ...splits.stats.short },
];
---

<Base title="Výsledky" description="Výsledky všech ročníků Krakonošova cyklomaratonu od roku 2014.">
  <PageHead
    title="Výsledky"
    lede="Třináct ročníků od roku 2014. Hlavní závod online na SportSoftu, dětské závody v PDF."
    mark={{ name: 'Cíl Trutnov', km: routes.routes.long.km }}
  />

  <section class="section" aria-label="Ročníky">
    <div class="wrap">
      <ol class="editions" style={`--archive-rows:${archive.length}`}>
        <li class="latest" id={`rocnik-${latest.n}`}>
          <div class="plate">
            <div class="lt-head">
              <h2 class="lt-title">
                <span class="lt-year num">{year(latest)}</span>
                <span class="lt-n num">{latest.n}. ročník</span>
              </h2>
              <p class="lt-date num">{latest.date}</p>
            </div>

            <dl class="podium">
              {
                winners.map((w) => (
                  <div class="fact">
                    <dt class="t-label">Vítěz · {w.route}</dt>
                    <dd>
                      <span class="who">{w.winner}</span> <span class="time num">{w.winnerTime}</span>
                    </dd>
                  </div>
                ))
              }
            </dl>

            <div class="lt-links">
              <a class="btn" href={latest.main.href} target="_blank" rel="noopener">
                {latest.main.label} (online)
                <Icon name="external" />
              </a>
              {
                latest.groups?.map((g, i) => (
                  <div class="grp">
                    {g.label && (
                      <p class="grp-label t-label" id={`g-${latest.n}-${i}`}>
                        {g.label}
                      </p>
                    )}
                    <ul aria-labelledby={g.label ? `g-${latest.n}-${i}` : undefined}>
                      {g.links.map((l) => (
                        <li>
                          <a class="res" href={l.href}>
                            {g.prefixed && <span class="visually-hidden">{g.label} - </span>}
                            {l.label}
                            <span class="fmt">
                              PDF <Icon name="download" />
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>
          </div>
        </li>

        {
          archive.map((e) => (
            <li class="ed" id={`rocnik-${e.n}`}>
              <h2 class="ed-title">
                <span class="ed-year num">{year(e)}</span>
                <span class="ed-n num">{e.n}. ročník</span>
              </h2>
              <p class="ed-date num">{e.date}</p>
              <div class="ed-links">
                <a class="res res--main" href={e.main.href} target="_blank" rel="noopener">
                  {e.main.label}
                  <span class="fmt">
                    online <Icon name="external" />
                  </span>
                </a>
                {e.groups?.map((g, i) => (
                  <div class="grp">
                    {g.label && (
                      <p class="grp-label t-label" id={`g-${e.n}-${i}`}>
                        {g.label}
                      </p>
                    )}
                    <ul aria-labelledby={g.label ? `g-${e.n}-${i}` : undefined}>
                      {g.links.map((l) => (
                        <li>
                          <a class="res" href={l.href}>
                            {g.prefixed && <span class="visually-hidden">{g.label} - </span>}
                            {l.label}
                            <span class="fmt">
                              PDF <Icon name="download" />
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .editions {
    list-style: none;
  }

  /* ---------- the latest edition: a paper plate opened by an ink rule ---------- */

  .latest {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .plate {
    display: grid;
    gap: 1.75rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    background: var(--paper);
    border: 1px solid var(--line);
    border-top: 3px solid var(--ink);
    border-radius: 2px;
  }

  .lt-title {
    display: grid;
    gap: 0.5rem;
  }

  .lt-year {
    font-stretch: 62%;
    font-weight: 820;
    font-size: clamp(4rem, 9vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.005em;
  }

  .lt-n {
    font-stretch: 72%;
    font-weight: 760;
    font-size: clamp(1.375rem, 2.4vw, 1.625rem);
    line-height: var(--lh-caps);
    text-transform: uppercase;
  }

  .lt-date {
    margin-top: 0.25rem;
    color: var(--ink-2);
    font-weight: 560;
  }

  .podium {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .fact {
    padding-block: 1rem 1.1rem;
  }

  .fact + .fact {
    padding-left: clamp(1rem, 2.5vw, 1.5rem);
    border-left: 1px solid var(--line);
  }

  .fact dt {
    color: var(--ink-3);
  }

  .fact dd {
    display: grid;
    gap: 0.3rem;
    margin: 0.55rem 0 0;
  }

  .who {
    font-stretch: 75%;
    font-weight: 760;
    font-size: 1.1875rem;
    line-height: 1.15;
  }

  .time {
    font-stretch: 70%;
    font-weight: 780;
    font-size: 1.375rem;
    line-height: 1.05;
  }

  .lt-links {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  /* the smallest phones keep the button on one line */
  @media (max-width: 23.99rem) {
    .lt-links .btn {
      padding-inline: 1rem;
      font-size: 1rem;
    }
  }

  /* ---------- the archive: one ruled row per edition, the year leads ---------- */

  /* phones: year | edition | date on the first line, results under edition and date */
  .ed {
    display: grid;
    grid-template-columns: 3.25rem 4.75rem minmax(0, 1fr);
    column-gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.75rem 0.5rem;
    border-bottom: 1px solid var(--line);
    transition: background-color 0.6s var(--ease-out);
  }

  .latest + .ed {
    border-top: 1.5px solid var(--ink);
  }

  /* a deep link (/vysledky/#rocnik-10) lands on a Mist row; the fill runs past the text */
  .ed:target {
    margin-inline: -0.75rem;
    padding-inline: 0.75rem;
    background: var(--ridge-100);
  }

  .ed-title {
    grid-column: 1 / 3;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
  }

  .ed-year {
    font-stretch: 66%;
    font-weight: 800;
    font-size: 1.625rem;
    line-height: 1;
  }

  .ed-n {
    font-stretch: 75%;
    font-weight: 720;
    font-size: 0.875rem;
    letter-spacing: 0.03em;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .ed-date {
    grid-column: 3;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .ed-links {
    grid-column: 2 / -1;
    display: grid;
    margin-top: 0.1rem;
  }

  /* secondary results: a condensed label naming the group, then its PDFs */
  .grp {
    display: grid;
  }

  .grp-label {
    color: var(--ink-3);
  }

  /* in an archive row a label opens a new group, well clear of the links above */
  .ed .grp-label {
    padding-top: 1.25rem;
  }

  /* Every result is one small button: its name, then the format and its mark behind a hairline.
     PDFs are outlined; the main race, online, is the same button in ink. The buttons wrap as a
     block; a label keeps 0.625rem clear of them, enough for the focus ring (3px at 3px offset). */
  .grp ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .grp-label + ul {
    margin-top: 0.625rem;
  }

  /* in an archive row the PDFs follow the main race and close the row */
  .ed .grp:not(:has(.grp-label)) {
    padding-top: 0.5rem;
  }

  .ed .grp:last-child {
    padding-bottom: 0.75rem;
  }

  .res {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.25rem;
    padding: 0.3rem 0.65rem 0.3rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: var(--paper);
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }

  .res:hover {
    border-color: var(--ink);
    background: var(--ink);
    color: #fff;
  }

  .res--main {
    justify-self: start;
    border-color: var(--ink);
    background: var(--ink);
    color: #fff;
  }

  .res--main:hover {
    border-color: var(--red);
    background: var(--red);
  }

  .fmt {
    display: inline-flex;
    align-items: center;
    align-self: stretch;
    gap: 0.3rem;
    padding-left: 0.6rem;
    border-left: 1px solid var(--line);
    color: var(--ink-3);
    font-stretch: 75%;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .fmt :global(svg) {
    flex: none;
    width: 0.95rem;
    height: 0.95rem;
    color: var(--red);
  }

  .res:hover .fmt,
  .res--main .fmt {
    border-color: var(--on-dark-line);
    color: var(--on-dark-2);
  }

  .res:hover .fmt :global(svg) {
    color: #fff;
  }

  .res--main:hover .fmt {
    border-color: rgba(255, 255, 255, 0.4);
    color: #fff;
  }

  /* ---------- wider: the row reads across, year · edition · date · results ---------- */

  @media (min-width: 40rem) {
    .plate {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(2rem, 5vw, 3.5rem);
      align-items: start;
    }

    /* the edition beside its winners; the results run along the foot of the plate */
    .lt-links {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 1.25rem clamp(2rem, 5vw, 3.5rem);
    }

    .ed {
      grid-template-columns: 3.75rem 5.25rem 8.75rem minmax(0, 1fr);
      column-gap: 1.25rem;
      padding-block: 0.45rem;
    }

    .ed-year {
      font-size: 1.75rem;
    }

    .ed-n {
      font-size: 0.9375rem;
    }

    .ed-date {
      font-size: 1rem;
    }

    .ed-links {
      grid-column: 4;
      margin-top: 0;
    }
  }

  /* once the first column fits the button, the results take the plate's columns:
     the button under the date, the PDFs under the winners */
  @media (min-width: 50rem) {
    .lt-links {
      display: grid;
      grid-template-columns: subgrid;
    }
  }

  /* ---------- desktop: the latest edition beside the archive ---------- */

  @media (min-width: 75rem) {
    .editions {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(2.5rem, 6vw, 6rem);
    }

    .latest {
      grid-column: 1;
      grid-row: 1 / span var(--archive-rows);
      margin-bottom: 0;
    }

    .ed {
      grid-column: 2;
    }

    .plate {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 75rem) and (min-height: 40rem) {
    .plate {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }
</style>
